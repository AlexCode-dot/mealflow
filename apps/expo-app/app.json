{
  "expo": {
    "name": "MealFlow",
    "slug": "mealflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/mealflow_icon_1024.png",
    "scheme": "mealflow",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alexcode.mealflow",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.alexcode.mealflow",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-adaptive/foreground.png",
        "backgroundImage": "./assets/android-adaptive/background.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icons/mealflow_icon_1024.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash/mealflow_splash_1242x2436.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MealFlow to access your photos so you can add recipe images."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "legal": {
        "privacyUrl": "https://alexcode-dot.github.io/mealflow-legal/privacy",
        "termsUrl": "https://alexcode-dot.github.io/mealflow-legal/terms",
        "accountDeletionUrl": "https://alexcode-dot.github.io/mealflow-legal/account-deletion"
      },
      "support": {
        "email": "mealflows@gmail.com"
      }
    }
  }
}
